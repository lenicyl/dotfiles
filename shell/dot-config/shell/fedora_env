#!/bin/sh
### Environment variables for all shells

# Prompt (Default with Green)
export PS1="\[\e[01;32m\]\u@\h\[\e[01;34m\] \w \$\[\e[00m\] "

# Programs
export EDITOR="emacsclient -c"
export BROWSER="firefox"

# Change the color of "Other writable files" on ls command to make it
# more readable on alacritty
LS_COLORS=$LS_COLORS:"ow=30;42:"

# Path
export CARGO_HOME="$HOME/.local/dev/cargo"
export RUSTUP_HOME="$HOME/.local/dev/rustup"
export PATH="$HOME/.local/bin:$CARGO_HOME/bin:$PATH"

export ANDROID_HOME="$HOME/.local/dev/android"
export PATH="$ANDROID_HOME/cmdline-tools/latest/bin:$PATH"
export PATH="$ANDROID_HOME/tools:$PATH"
export PATH="$ANDROID_HOME/tools/bin:$PATH"
export PATH="$ANDROID_HOME/platform-tools:$PATH"

export FLUTTER_HOME="$HOME/.local/dev/flutter"
export PATH="$FLUTTER_HOME/bin:$PATH"

export GEM_HOME="$HOME/.local/dev/gem"
export PATH="$GEM_HOME/bin:$PATH"

export PATH="$HOME/.local/dev/jdtls/bin:$PATH"
